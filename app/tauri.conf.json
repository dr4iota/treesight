{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "treesight",
  "version": "0.2.0",
  "identifier": "xyz.driota.treesight",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "shortDescription": "Browse a folder as a rendered website",
    "longDescription": "treeserve renders a directory tree as a browsable site — syntax-highlighted code, Markdown with LaTeX math, media previews — served locally and shown in a native window."
  }
}
